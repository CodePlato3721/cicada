{
  "name": "cicada",
  "version": "0.1.0",
  "description": "Discord 实时语音翻译 Bot POC",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:copy-assets",
    "build:copy-assets": "node -e \"require('fs').cpSync('src/domain/terminology','dist/domain/terminology',{recursive:true});require('fs').cpSync('src/domain/keyterms','dist/domain/keyterms',{recursive:true});require('fs').mkdirSync('dist/config',{recursive:true});require('fs').copyFileSync('src/config/tts-voices-azure.json','dist/config/tts-voices-azure.json');require('fs').copyFileSync('src/config/tts-voices-deepgram.json','dist/config/tts-voices-deepgram.json');require('fs').copyFileSync('src/config/tts-providers.json','dist/config/tts-providers.json');require('fs').copyFileSync('src/config/stt-providers.json','dist/config/stt-providers.json')\"",
    "build:scripts": "tsc -p scripts/tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "billing": "npm run build && node dist/billing-cli.js",
    "migrate": "npm run build:scripts && node dist/scripts/migrate-db.js",
    "deploy-commands": "npm run build && node dist/deploy-commands.js",
    "deploy-commands:global": "npm run build && node dist/deploy-commands.js --global",
    "scrape-terms": "npm run build:scripts && node dist/scripts/scrape-terms.js",
    "merge-terms": "npm run build:scripts && node dist/scripts/merge-terms.js",
    "scrape-lang": "npm run build:scripts && node dist/scripts/scrape-lang.js",
    "merge-lang": "npm run build:scripts && node dist/scripts/merge-lang.js",
    "test:unit": "npm run build && npm run build:scripts && node --test tests/unit/domain/*.test.js tests/unit/application/*.test.js tests/unit/scripts/*.test.js",
    "test:e2e": "npm run build && node --test tests/e2e/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@ricky0123/vad-node": "^0.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.5.0",
    "ioredis": "^5.11.1",
    "libsodium-wrappers": "^0.8.4",
    "onnxruntime-node": "^1.27.0",
    "opencc-js": "^1.4.1",
    "opusscript": "^0.0.8",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prism-media": "^1.3.5",
    "wav": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
