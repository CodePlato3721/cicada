# Groq —— 官方 SDK 默认读取这个变量名
GROQ_API_KEY=

# --- STT/翻译/TTS 三个环节各自独立可切换，改对应的 PROVIDER 变量就行，不用改代码 ---
# 翻译供应商：groq / deepseek，默认 groq。Groq 翻译额度/Developer tier 撞限或暂停时切 deepseek。
TRANSLATE_PROVIDER=deepseek
# STT 供应商：groq / deepgram
STT_PROVIDER=groq
# TTS 供应商：groq / deepgram
TTS_PROVIDER=groq

# DeepSeek API Key（TRANSLATE_PROVIDER=deepseek 时必填），控制台：platform.deepseek.com
DEEPSEEK_API_KEY=

# Deepgram API Key（STT_PROVIDER=deepgram 或 TTS_PROVIDER=deepgram 时必填），控制台：console.deepgram.com
DEEPGRAM_API_KEY=

# STT/翻译/TTS 每次请求的超时时间（毫秒）。超时就直接失败、跳过这一句，不会无限等。
# 实测踩过坑：没有超时保护时，某次请求卡了 34 秒才返回，用户体验上像是"卡很久突然冒出好几句话"。
API_TIMEOUT_MS=15000

# Discord Developer Portal → Bot 页面
DISCORD_BOT_TOKEN=
# Developer Portal → 概况/基本信息 页面的 Application ID
DISCORD_CLIENT_ID=

# 私人测试服务器的 Guild ID（Discord 客户端需先开启开发者模式才能"复制服务器 ID"）
# 用于把斜杠命令即时注册到单个服务器，避免全局命令注册后的传播延迟
DISCORD_TEST_GUILD_ID=

# --- Silero VAD 切句参数（本地运行，不联网）---
# 判定"一句话说完"所需的静音时长（毫秒）。太短会把自然停顿切碎，太长增加延迟。
VAD_SILENCE_MS=700
# 判定为"有人在说话"的概率阈值（0-1）
VAD_POSITIVE_THRESHOLD=0.5
# 判定为"安静"的概率阈值（0-1），需要小于上面那个
VAD_NEGATIVE_THRESHOLD=0.35
# 一段语音至少要有多少个 VAD 帧（每帧约 96ms）才算数，用来过滤误触发的短促噪音
VAD_MIN_SPEECH_FRAMES=3

# 源语言提示（ISO-639-1 代码，如 'zh'）。不设置就让 Whisper 自动检测语种；
# 显式指定能提升 STT 准确率和速度（Groq 官方建议）。
SOURCE_LANG=

# 翻译目标语言（ISO-639-1 代码）
TRANSLATE_TARGET_LANG=en

# TTS 音色。默认留空——不设置的话，每个说话人第一次开口时会按本地判断的性别
# 自动从当前 TTS_PROVIDER 的音色池里挑一个（男/女各自的音色列表见对应 adapter/out/*/tts.js），
# 整场会话保持不变；不同说话人尽量不撞音色。
# 手动填一个值（比如 autumn）会强制所有人用同一个音色，用于调试或懒得听区分效果时的回退。
TTS_VOICE=

# 判断说话人性别的基频阈值（Hz）：估算出的基频低于这个数判男声，否则判女声。
# 纯本地启发式（自相关法估基频），不是精确声纹识别，判错很正常——只用来选音色池子。
GENDER_PITCH_THRESHOLD_HZ=165

# 语速倍率（本地后处理，Groq 的 speed 参数对 Orpheus 实测不生效）。
# 1 = 原速；调大会变快但音调也会跟着变高，1.3 以上比较明显。
TTS_SPEED=1.15

# --- 调试录音（recordings/）---
# 是否保留每句话的原始录音 + TTS 结果到 recordings/，方便回放排查问题。
# 设为 false 就不留档：输入录音只临时写到系统 temp 目录、喂完 STT 立刻删（不影响主链路），
# 输出（TTS）录音直接跳过不写。
SAVE_RECORDINGS=true
# SAVE_RECORDINGS=true 时，超过这个小时数的旧录音会在写入新文件时顺手清掉，避免无限增长。
RECORDINGS_RETENTION_HOURS=24
