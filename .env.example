# --- STT/翻译 两个环节各自独立可切换，改对应的 PROVIDER 变量就行，不用改代码 ---
# STT 供应商：groq / deepgram
STT_PROVIDER=deepgram
# 翻译供应商：groq / deepseek，默认 groq。Groq 翻译额度/Developer tier 撞限或暂停时切 deepseek。
TRANSLATE_PROVIDER=deepseek
# 注意：这里没有 TTS_PROVIDER——TTS 不再是"进程启动时选一个供应商用到底"，而是按目标
# 语言动态路由到不同供应商（哪个语言对应哪个供应商，见 src/application/ports/tts.js
# 的 TTS_PROVIDER_BY_LANG），因为没有一个供应商能覆盖这个项目要的全部目标语言。
# 想调整某个语言该用哪个供应商，改那张表，不是改这里的环境变量。

# --- 各供应商 API Key ---
# Groq —— 官方 SDK 默认读取这个变量名
GROQ_API_KEY=
# DeepSeek API Key（TRANSLATE_PROVIDER=deepseek 时必填），控制台：platform.deepseek.com
DEEPSEEK_API_KEY=
# Deepgram API Key（STT_PROVIDER=deepgram，或某个目标语言路由到 deepgram TTS 时必填），
# 控制台：console.deepgram.com
DEEPGRAM_API_KEY=
# Azure Speech API Key/Region（某个目标语言路由到 azure TTS 时必填，目前是 zh/ko/pt/ar），
# 控制台：Azure Portal → 你的 Speech 资源 → 密钥和终结点。Region 是资源所在区域的短代码
# （比如 eastus），不是完整域名。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- STT 识别关键词增强（Deepgram keyterm prompting，目前只在源语言锁定为中文时启用）---
# 每次请求最多附带多少个关键词（词表见 src/domain/keyterms/<game>.json，按文件里的
# 顺序取前 N 个）。Deepgram 官方硬上限是 500 token（约 100 个词，超了直接报错），
# 但官方建议实际控制在 20-50 个以内，塞太多反而会干扰正常识别，默认 50（建议区间上沿）。
STT_KEYTERM_LIMIT=50

# --- Discord ---
# Discord Developer Portal → Bot 页面
DISCORD_BOT_TOKEN=
# Developer Portal → 概况/基本信息 页面的 Application ID
DISCORD_CLIENT_ID=
# 私人测试服务器的 Guild ID（Discord 客户端需先开启开发者模式才能"复制服务器 ID"）
# 用于把斜杠命令即时注册到单个服务器，避免全局命令注册后的传播延迟
DISCORD_TEST_GUILD_ID=

# --- Silero VAD 切句参数（本地运行，不联网）---
# 判定"一句话说完"所需的静音时长（毫秒）。太短会把自然停顿切碎，太长增加延迟。
VAD_SILENCE_MS=700
# 判定为"有人在说话"的概率阈值（0-1）
VAD_POSITIVE_THRESHOLD=0.5
# 判定为"安静"的概率阈值（0-1），需要小于上面那个
VAD_NEGATIVE_THRESHOLD=0.35
# 一段语音至少要有多少个 VAD 帧（每帧约 96ms）才算数，用来过滤误触发的短促噪音
VAD_MIN_SPEECH_FRAMES=3

# --- 源语言/目标语言 ---
# 两者都没有默认值、也没有对应的环境变量可以预设：
# - 源语言：/lang source:<语言> 手动设置优先；没手动设置的话，第一句话会让 STT 自动
#   检测语种，检测结果会锁定进 session，之后同一场会话都用这个语种（不用每句话都重新
#   检测），并且会在语音频道文字聊天里通知一声检测到了什么语言。
# - 目标语言：/join 之后必须显式用 /lang target:<语言> 设置一次才能开始翻译，设置之前
#   说话不会被翻译，只会收到语音提示（见 pipeline.js）。目标语言选定的同时会决定用哪个
#   TTS 供应商播报（见上面 TTS_PROVIDER_BY_LANG 那条说明）。
# 两者都是刻意的产品决定：避免用户没注意到默认翻成了某个语言，说话被翻成自己没打算
# 要的语言。

# --- TTS 音色/语速 ---
# TTS 音色。默认留空——不设置的话，每个说话人第一次用某个 TTS 供应商播报时，会按本地
# 判断的性别自动从那个供应商的音色池里挑一个（男/女各自的音色列表见对应 adapter/out/*/tts.js），
# 同一个供应商下整场会话保持不变；不同说话人尽量不撞音色。目标语言变化导致供应商切换时，
# 会给新供应商单独分配一个（不保证跟旧供应商听感一致）。
# 手动填一个值（比如某个具体音色名）会强制所有人用同一个音色，用于调试或懒得听区分效果
# 时的回退——注意这个值必须对当前实际路由到的供应商有效，多供应商场景下换了目标语言、
# 换了供应商，同一个覆盖值可能就失效了。
TTS_VOICE=

# 判断说话人性别的基频阈值（Hz）：估算出的基频低于这个数判男声，否则判女声。
# 纯本地启发式（自相关法估基频），不是精确声纹识别，判错很正常——只用来选音色池子。
GENDER_PITCH_THRESHOLD_HZ=165

# 语速倍率（本地后处理，Groq 的 speed 参数对 Orpheus 实测不生效）。
# 1 = 原速；调大会变快但音调也会跟着变高，1.3 以上比较明显。
TTS_SPEED=1.15

# STT/翻译/TTS 每次请求的超时时间（毫秒）。超时就直接失败、跳过这一句，不会无限等。
# 实测踩过坑：没有超时保护时，某次请求卡了 34 秒才返回，用户体验上像是"卡很久突然冒出好几句话"。
API_TIMEOUT_MS=5000

# --- Redis ---
# Redis 用于用户/guild session 和翻译缓存，本地开发可用 docker-compose 启动。
# 格式：redis://[:password@]host:port[/db]
REDIS_URL=redis://127.0.0.1:6379
# 单条 Redis 命令的超时（毫秒），默认 1000。跟 API_TIMEOUT_MS 是两套独立的超时配置
# （那个是手写 fetch 调用专用的，Redis 走 ioredis 自己的 commandTimeout 机制）。
REDIS_COMMAND_TIMEOUT_MS=1000
# 目前翻译缓存只覆盖中文源语言（见 DESIGN.md），命中缓存直接返回译文、跳过 LLM 翻译调用。
# 缓存条目的存活时间（秒），默认 259200（3 天）。过期纯靠这个 TTL 自然淘汰，没有
# 手动/事件驱动的失效机制（比如术语库更新不会主动清相关缓存）。
TRANSLATE_CACHE_TTL_SECONDS=259200

# --- Database ---
DATABASE_URL=postgresql://cicada:cicada_dev_password@127.0.0.1:5432/cicada

# --- 调试录音 ---
# 是否保留每句话的原始录音 + TTS 结果，方便回放排查问题。
# 设为 false 就不留档：输入录音只临时写到系统 temp 目录、喂完 STT 立刻删（不影响主链路），
# 输出（TTS）录音直接跳过不写。
SAVE_RECORDINGS=true
# SAVE_RECORDINGS=true 时，中间文件保存到哪里。必须显式配置，建议填项目外部的绝对路径；
# 不配置时启动会直接报错，避免录音悄悄落到项目源文件夹里。
# Windows 示例：C:\cicada-recordings
# Linux 示例：/var/lib/cicada/recordings
RECORDINGS_DIR=
# SAVE_RECORDINGS=true 时，超过这个小时数的旧录音会在写入新文件时顺手清掉，避免无限增长。
RECORDINGS_RETENTION_HOURS=24

# --- 日志 ---
# 日志级别：trace/debug/info/warn/error/fatal，默认 info。
# adapter/out/logger.js 统一给所有日志加时间戳 + level + 模块标签（结构化 JSON），
# 不用再各自手写 console.log/console.error。
LOG_LEVEL=info
